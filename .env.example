ERP_DB_USER=your_readonly_user
ERP_DB_PASSWORD=your_password
ERP_DB_SERVER=your_sql_server
ERP_DB_DATABASE=your_database
# This ERP server requires legacy, unencrypted SQL connections.
ERP_DB_ENCRYPT=false
# Leave certificate validation enabled when using encryption.
ERP_DB_TRUST_CERTIFICATE=false
HOST=127.0.0.1
PORT=3000
